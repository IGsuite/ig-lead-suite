# Neon Postgres — Dashboard → Project → Connection string (URI)
# Use the pooled connection for the app (often includes -pooler in the host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Telnyx — SMS delivery backend (Mission Control → API Keys)
# Without these, Autopilot / campaigns run in mock mode.
TELNYX_API_KEY=
# Default from-number if an entity has no phoneNumbers yet (E.164, e.g. +15551234567)
TELNYX_FROM_NUMBER=

# Cold email — Instantly or Smartlead (recommended over SES/SendGrid for cold)
# INSTANTLY_API_KEY=
# SMARTLEAD_API_KEY=

# Optional verify vendors (local format checks used until set)
# NEVERBOUNCE_API_KEY=

# CRM / website sync
# N8N_WEBHOOK_URL=
