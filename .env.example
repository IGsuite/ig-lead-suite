# Neon Postgres — Dashboard → Project → Connection string (URI)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Public HTTPS base (Vercel deploy or Cloudflare Tunnel). Used in docs / setup copy.
# Example tunnel: https://xxxx.trycloudflare.com
PUBLIC_APP_URL=

# Telnyx — SMS (Mission Control → API Keys + Numbers)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Messaging profile webhook → ${PUBLIC_APP_URL}/api/webhooks/telnyx

# Cold email — Smartlead (preferred for this setup) or Instantly
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=
# Optional per-entity Smartlead campaigns (maps webhook campaign_id → entity inbox):
# SMARTLEAD_CAMPAIGN_ABSTRACT=
# SMARTLEAD_CAMPAIGN_AHAVA=
# SMARTLEAD_CAMPAIGN_TAKEMORE=
# SMARTLEAD_CAMPAIGN_VENTURE=
# SMARTLEAD_CAMPAIGN_TYH=
# Smartlead reply webhook → ${PUBLIC_APP_URL}/api/webhooks/email  (event: EMAIL_REPLY)

# Instantly (alternative — used if INSTANTLY_API_KEY is set, takes precedence)
# INSTANTLY_API_KEY=
# INSTANTLY_CAMPAIGN_ID=
# INSTANTLY_CAMPAIGN_ABSTRACT=
# INSTANTLY_CAMPAIGN_AHAVA=
# INSTANTLY_CAMPAIGN_TAKEMORE=
# INSTANTLY_CAMPAIGN_VENTURE=
# INSTANTLY_CAMPAIGN_TYH=

# Optional verify vendors
# NEVERBOUNCE_API_KEY=

# CRM sync later
# N8N_WEBHOOK_URL=
