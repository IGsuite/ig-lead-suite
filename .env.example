# Neon Postgres — Dashboard → Project → Connection string (URI)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Session auth (cookie). On Vercel/production, login is required by default.
# Local demos stay open unless AUTH_REQUIRED=true.
AUTH_SECRET=replace-with-long-random-string
AUTH_ADMIN_EMAIL=admin@signaldesk.local
# Required on Vercel/production (never rely on changeme there).
AUTH_ADMIN_PASSWORD=changeme
# Optional alternate admin passcode (also used as bootstrap password if AUTH_ADMIN_PASSWORD unset)
# SITE_ACCESS_CODE=
# Force login locally, or set false to disable the Vercel default lock:
# AUTH_REQUIRED=true
# AUTH_REQUIRED=false

# Public HTTPS base (Vercel deploy or Cloudflare Tunnel). Used in docs / setup copy.
# Example tunnel: https://xxxx.trycloudflare.com
PUBLIC_APP_URL=

# Optional invite email on Users → create / reset password.
# Prefer Resend; SMTP is the fallback. Telnyx is SMS-only — not used for invites.
# Without a key/host, the share panel still appears (toast: “Invite email skipped — copy and share”).
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=IG Lead Suite <invites@yourdomain.com>
# AUTH_INVITE_FROM=                     # alias for INVITE_FROM_EMAIL
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=                            # or reuse INVITE_FROM_EMAIL
# SMTP_SECURE=false                     # true for port 465

# Telnyx — SMS (Mission Control → API Keys + Numbers)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Live SMS/email API calls per Launch batch (default 2000, hard max 10000).
# SMS_LIVE_CAP=2000
# TELNYX_LIVE_CAP=2000   # alias for SMS_LIVE_CAP
# EMAIL_LIVE_CAP=2000
# Messaging profile webhook → ${PUBLIC_APP_URL}/api/webhooks/telnyx

# Cold email — Smartlead (preferred for this setup) or Instantly
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=
# Optional per-entity Smartlead campaigns (maps webhook campaign_id → entity inbox):
# SMARTLEAD_CAMPAIGN_ABSTRACT=
# SMARTLEAD_CAMPAIGN_AHAVA=
# SMARTLEAD_CAMPAIGN_TAKEMORE=
# SMARTLEAD_CAMPAIGN_VENTURE=
# SMARTLEAD_CAMPAIGN_TYH=
# Smartlead reply webhook → ${PUBLIC_APP_URL}/api/webhooks/email  (event: EMAIL_REPLY)

# Instantly (alternative — used if INSTANTLY_API_KEY is set, takes precedence)
# INSTANTLY_API_KEY=
# INSTANTLY_CAMPAIGN_ID=
# INSTANTLY_CAMPAIGN_ABSTRACT=
# INSTANTLY_CAMPAIGN_AHAVA=
# INSTANTLY_CAMPAIGN_TAKEMORE=
# INSTANTLY_CAMPAIGN_VENTURE=
# INSTANTLY_CAMPAIGN_TYH=

# Ads → AI wording (Gemini via Vercel AI SDK)
# Prefer one of:
# AI_GATEWAY_API_KEY=          # Vercel AI Gateway (model: google/gemini-3.5-flash)
# GOOGLE_GENERATIVE_AI_API_KEY= # Google AI Studio / Gemini API
# GEMINI_API_KEY=               # alias for GOOGLE_GENERATIVE_AI_API_KEY
# Without a key, /creatives still returns compliance-minded demo drafts.

# Campaign builder → Draft with AI (OpenAI / ChatGPT)
# Optional — Campaigns → Build works without it (demo draft + clear notice).
# OPENAI_API_KEY=
# Vercel: Project → Settings → Environment Variables → OPENAI_API_KEY (Production + Preview)

# Optional verify vendors
# NEVERBOUNCE_API_KEY=

# Social Media (Meta / TikTok) — optional; planning UI works without these.
# Live publish / Insights sync is not wired yet — store connection status in-app.
# META_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=

# CRM sync later
# N8N_WEBHOOK_URL=

# SEO command center: optional. Never put credentials in the browser or setup notes.
# AHREFS_API_KEY=  # Eligible paid API access; Free/Starter do not include the report feed.
# IGF Ventures read-only SEO events feed. Keep unset until the destination is ready.
# COMMAND_CENTER_SEO_TOKEN=  # dedicated random secret, at least 32 characters
# COMMAND_CENTER_SEO_ENTITIES=abstract  # explicit company scope, never defaults to all

# Production hardening (configure separate random secrets; never commit real values)
# AUTH_SECRET must be at least 32 characters. Production authentication is always required.
CRON_SECRET=
EMAIL_WEBHOOK_SECRET=
TELNYX_PUBLIC_KEY=
# Private Vercel Blob store (OIDC store ID or a read/write token)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Enable only after migrations, provider checks, and controlled-contact verification.
SENDING_ENABLED=false
