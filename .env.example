# Neon Postgres — Dashboard → Project → Connection string (URI)
# Use the pooled connection for the app (often includes -pooler in the host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Optional later:
# NEVERBOUNCE_API_KEY=          # email verification (local format checks used until set)
# TWILIO_ACCOUNT_SID=           # phone lookup + SMS
# TWILIO_AUTH_TOKEN=
# AWS_ACCESS_KEY_ID=            # SES email
# AWS_SECRET_ACCESS_KEY=
# N8N_WEBHOOK_URL=              # CRM / website sync
