// SignalDesk — Neon Postgres schema (shared lead pool + entity portals)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One company portal (Abstract, Ahava, Take More, Venture, TYH)
model Entity {
  id               String   @id
  name             String
  shortName        String
  focus            String
  programs         String[]
  domain           String
  sendingSubdomain String
  websiteUrl       String
  websiteApiUrl    String   @default("")
  crm              String
  status           String
  phoneNumbers     String[]
  tenDlcStatus     String
  emailAuthStatus  String
  weeklySendCap    Int      @default(0)
  rotationEnabled  Boolean  @default(true)
  /// JSON SocialLinks: website, facebook, instagram, tiktok, linkedin, youtube, x, other
  socialLinks      Json     @default("{}")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaigns        Campaign[]
  replies          Reply[]
  socialCampaigns  SocialCampaign[]
  socialConnections SocialConnection[]
  sendEvents       LeadSendEvent[]
}

model Lead {
  id                String    @id
  email             String?
  phone             String?
  firstName         String?
  lastName          String?
  /// Company / DBA / merchant name from vendor CSVs
  businessName      String?
  source            String
  /// Optional buy/list group within a source (e.g. "Week 12 MCA file")
  groupName         String    @default("General")
  purchaseDate      DateTime  @db.Date
  costCents         Int
  offeredEntityIds  String[]
  lastEntityId      String?
  convertedEntityId String?
  status            String
  optedOut          Boolean   @default(false)
  emailStatus       String    @default("unverified")
  phoneStatus       String    @default("unverified")
  verifyNotes       String?
  verifiedAt        DateTime?
  uploadBatchId     String?
  createdAt         DateTime  @default(now())

  uploadBatch UploadBatch? @relation(fields: [uploadBatchId], references: [id])
  replies     Reply[]
  sendEvents  LeadSendEvent[]

  @@index([source])
  @@index([groupName])
  @@index([status])
  @@index([optedOut])
  @@index([emailStatus])
  @@index([phoneStatus])
  @@index([businessName])
}

/// Durable send / assignment history for fair Auto wheel + Own campaign rotation
model LeadSendEvent {
  id                  String   @id
  leadId              String
  entityId            String
  campaignId          String
  /// sms | email
  channel             String
  messageFingerprint  String
  /// auto | own
  mode                String   @default("own")
  sentAt              DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([entityId])
  @@index([campaignId])
  @@index([channel])
  @@index([messageFingerprint])
  @@index([sentAt])
  @@index([leadId, messageFingerprint])
  @@index([leadId, channel, sentAt])
}

model UploadBatch {
  id             String   @id
  filename       String
  source         String
  groupName      String   @default("General")
  purchaseDate   DateTime @db.Date
  costCents      Int
  rowCount       Int
  duplicateCount Int
  importedCount  Int
  createdAt      DateTime @default(now())

  leads Lead[]
}

model Campaign {
  id              String    @id
  brandId         String
  name            String
  channel         String
  subject         String?
  message         String
  /// Optional HTML body override (email). When null, HTML is built from message + image.
  htmlMessage     String?
  /// Public image URL embedded in HTML email (https…). Plain-text fallback omits it.
  imageUrl        String?
  imageAlt        String?
  sourceFilter    String    @default("all")
  groupFilter     String    @default("all")
  preferUnoffered Boolean   @default(true)
  /// Only queue leads with valid (or risky) verified contacts for the channel
  preferVerified  Boolean   @default(true)
  /// auto | own — Auto = Ferris wheel; Own = standalone entity campaign
  mode            String    @default("own")
  volume          Int
  throttlePerHour Int
  /// morning | afternoon | evening | custom | any
  sendWindowPreset String   @default("any")
  /// Local HH:mm (used when preset=custom, also stored for presets)
  sendWindowStart  String?
  sendWindowEnd    String?
  /// IANA timezone for the send window (default America/New_York)
  timezone         String   @default("America/New_York")
  status          String
  sentCount       Int       @default(0)
  replyCount      Int       @default(0)
  optOutCount     Int       @default(0)
  bounceCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  startedAt       DateTime?

  entity     Entity          @relation(fields: [brandId], references: [id])
  replies    Reply[]
  sendEvents LeadSendEvent[]

  @@index([brandId])
  @@index([status])
  @@index([mode])
}

/// Per-entity (or shared) folder in the Ads library
model AdFolder {
  id        String   @id
  name      String
  /// null = shared library; otherwise one entity portal
  brandId   String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    AdFolder?         @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  AdFolder[]        @relation("FolderTree")
  templates MessageTemplate[]
  assets    AdAsset[]

  @@index([brandId])
  @@index([parentId])
}

/// Uploaded marketing file (image/doc) — bytes live under .data/ad-assets/
model AdAsset {
  id           String   @id
  /// null = shared library; otherwise one entity portal
  brandId      String?
  folderId     String?
  name         String
  originalName String
  mimeType     String
  sizeBytes    Int
  /// Relative path under .data/ad-assets/ (e.g. abstract/folder/file.png)
  storagePath  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder AdFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([folderId])
}

/// Reusable SMS / email copy — write once, pull into campaigns
model MessageTemplate {
  id        String   @id
  name      String
  channel   String
  subject   String?
  body      String
  /// null = shared library; otherwise scoped to one entity portal
  brandId   String?
  /// Optional folder within that entity's Ads library
  folderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder AdFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([brandId])
  @@index([folderId])
}

/// Ops users — admin sees all entities; member only allowedEntityIds
model AppUser {
  id                String   @id
  email             String   @unique
  name              String
  passwordHash      String
  role              String   @default("member")
  allowedEntityIds  String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Reply {
  id              String   @id
  campaignId      String
  brandId         String
  leadId          String
  channel         String
  from            String
  body            String
  sentiment       String
  manualForwarded Boolean  @default(false)
  crmSynced       Boolean  @default(false)
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  entity   Entity   @relation(fields: [brandId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@index([brandId])
  @@index([read])
}

model OptOut {
  id        String   @id
  contact   String
  channel   String
  reason    String
  brandId   String?
  createdAt DateTime @default(now())

  @@index([contact])
}

model ProviderSpend {
  source          String @id
  leadsPurchased  Int    @default(0)
  costCents       Int    @default(0)
  replies         Int    @default(0)
  conversions     Int    @default(0)
}

/// Manual + auto cost ledger (SMS, email, setup, integrations, list buys)
model CostEntry {
  id          String   @id
  brandId     String?
  category    String
  label       String
  vendor      String?
  amountCents Int
  incurredAt  DateTime @db.Date
  notes       String?
  createdAt   DateTime @default(now())

  @@index([brandId])
  @@index([category])
  @@index([incurredAt])
}

/// Per-entity Meta / TikTok ad campaign (planning + metrics placeholders)
model SocialCampaign {
  id                  String    @id
  entityId            String
  /// meta | tiktok
  platform            String
  name                String
  /// draft | active | paused | archived
  status              String    @default("draft")
  objective           String    @default("")
  budgetCents         Int?
  dailyBudgetCents    Int?
  targetingNotes      String?
  primaryText         String?
  cta                 String?
  landingUrl          String?
  notes               String?
  /// Optional link to Ads library asset / template
  creativeAssetId     String?
  creativeTemplateId  String?
  scheduleStart       DateTime?
  scheduleEnd         DateTime?
  impressions         Int       @default(0)
  clicks              Int       @default(0)
  leads               Int       @default(0)
  spendCents          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
  @@index([platform])
  @@index([status])
}

/// Per-entity platform connection (mock/local until real OAuth)
model SocialConnection {
  id               String   @id
  entityId         String
  /// meta | tiktok
  platform         String
  /// not_connected | connected | needs_setup
  status           String   @default("not_connected")
  adAccountId      String?
  pixelOrEventsId  String?
  accessTokenNote  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, platform])
  @@index([entityId])
  @@index([platform])
}

/// Singleton row (id = "default") for rotation + autopilot config
model PlatformSettings {
  id               String    @id @default("default")
  version          Int       @default(14)
  mode             String    @default("round_robin")
  entityOrder      String[]
  notes            String    @default("")
  autopilotEnabled Boolean   @default(false)
  /// JSON: { quotas, lastRunAt?, nextRunAt?, poolCursor? }
  autopilotJson    Json      @default("{}")
  updatedAt        DateTime  @updatedAt
}

/// Durable outbox. A processing job is never blindly retried after an uncertain provider response.
model SendJob {
  id String @id
  campaignId String
  leadId String
  entityId String
  channel String
  payload Json
  status String @default("queued")
  providerId String?
  error String?
  scheduledAt DateTime @default(now())
  claimedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([campaignId, leadId])
  @@index([status, scheduledAt])
  @@index([providerId])
}

model WebhookReceipt {
  id String @id
  createdAt DateTime @default(now())
}

model WorkerLease {
  id String @id
  owner String
  expiresAt DateTime
}

/// Prevent changing the sequence behind contacts already queued in a provider campaign.
model ProviderCampaignBinding {
  id String @id
  fingerprint String
  campaignId String
  createdAt DateTime @default(now())
}

/// Preserve receipts that arrive before the provider request has returned its ID.
model DeliveryReceipt {
  providerId String @id
  status String
  updatedAt DateTime @updatedAt
}
